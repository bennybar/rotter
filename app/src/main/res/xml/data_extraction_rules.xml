<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up settings, read state and saved scoops, but not the
     rotter session (WebView cookies) or the Keystore-wrapped credentials,
     which can't be decrypted on another device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
